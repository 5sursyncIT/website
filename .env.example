# Non secret examples; secret files must be created only after explicit validation.
APP_ORIGIN=https://preprod.5sursync.com
ADMIN_ORIGIN=http://localhost:3105
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
POSTGRES_DB=syncit
POSTGRES_USER=syncit
POSTGRES_PASSWORD_FILE=/run/secrets/db_password
PAYLOAD_SECRET_FILE=/run/secrets/payload_secret
DATABASE_URI_FILE=/run/secrets/database_uri
PRIVATE_UPLOAD_PATH=/app/storage/private
MEDIA_STORAGE_PATH=/app/storage/media
# SMTP unset: requests are saved; no mail is claimed sent.
# SMTP_HOST=mail.example.test
# SMTP_PORT=587
# SMTP_USER=service@example.test
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# CONTACT_NOTIFICATION_EMAIL=team@example.test
# CRM mailbox (production only; documentation/messagerie-simafri.md). One provider at a time.
# MAIL_ENABLED=true
# MAIL_PROVIDER=imap
# MAIL_PASSWORD_FILE=/run/secrets/crm_mail_password
# MAIL_SEND_ALLOWLIST=recette@example.test
